grammar com.drodo.gbsokoban.GBSokoban with org.eclipse.xtext.common.Terminals
	hidden(WS, ML_COMMENT, SL_COMMENT, SEPARATOR)

generate gBSokoban "http://www.drodo.com/gbsokoban/GBSokoban"

// =====
// GAME
// =====

Game:
	(('TITLE' title=STRING)? &
	('AUTHOR' author=STRING)? &
	('MOVE_SPEED' moveSpeed=INT)? &
	('ANIM_SPEED' animSpeed=INT)? &
	('ENDING' ending=STRING)? &
	(canPull?='PLAYER_CAN_PULL')? &
	(noLevelSelect?='NO_LEVEL_SELECT')?)
	'PALETTES' palettes+=PaletteDef+
	'TEXTURES' textures+=Texture+
	'TILES' tiles+=TileDef+
	('OBJECTS' objects+=ObjectDef+)?
	'PLAYER' player=Player
	'LEGEND' legend+=LegendEntry+
	'WIN' win+=WinCondition+
	('SOUNDS' sounds+=Sound+)?
	'LEVELS' levels+=Level+;

// =========
// PALETTES
// =========

PaletteDef:
	name=ID (shades+=DmgShade+ | colors+=RgbColor+);

enum DmgShade:
	DMG_WHITE | DMG_LITE_GRAY | DMG_DARK_GRAY | DMG_BLACK;

RgbColor:
	name=RgbName | hex=HEX;

enum RgbName:
	RGB_RED | RGB_DARKRED | RGB_GREEN | RGB_DARKGREEN | RGB_BLUE | RGB_DARKBLUE |
	RGB_YELLOW | RGB_DARKYELLOW | RGB_CYAN | RGB_AQUA | RGB_PINK | RGB_PURPLE |
	RGB_BLACK | RGB_DARKGRAY | RGB_LIGHTGRAY | RGB_WHITE | RGB_LIGHTFLESH |
	RGB_BROWN | RGB_ORANGE | RGB_TEAL;

// =========
// TEXTURES
// =========

Texture:
	name=ID 'USES' palette=[PaletteDef]
	rows+=STRING*;

// ======
// TILES
// ======

TileDef:
	name=ID symbol=STRING 'USES' texture=[Texture] behaviour=TileBehaviour?;

TileBehaviour:
	Solid | Ice | Deadly | Crumble | Fillable | Conveyor;

Solid:    {Solid}   'BLOCKS';
Ice:      {Ice}     'SLIDES';
Deadly:   {Deadly}  'DESTROYS';
Crumble:  'COLLAPSES' 'INTO' target=[TileDef];
Fillable: 'FILLS'     'INTO' target=[TileDef];
Conveyor: 'CARRIES'   direction=Direction;

// ========
// OBJECTS
// ========

ObjectDef:
	name=ID 'USES' texture=[Texture]
	('ON_GOAL' goalTexture=[Texture])?;

// =======
// PLAYER
// =======

Player:
	anims+=Animation+;

Animation:
	kind=AnimKind direction=Direction (frames=FrameList | mirror=MirrorOf);

enum AnimKind: WALK | PUSH | PULL;

FrameList:
	textures+=[Texture]+;

MirrorOf:
	'MIRROR' source=Direction;

enum Direction: DOWN | UP | LEFT | RIGHT;

// =======
// LEGEND
// =======

LegendEntry:
	symbol=STRING '=' subject=Subject 'ON' tile=[TileDef];

Subject: PlayerRef | ObjectRef;
PlayerRef: {PlayerRef} 'PLAYER';
ObjectRef: object=[ObjectDef];

// ====
// WIN
// ====

WinCondition: AllOn | SomeOn | NoEntity;
AllOn:  'ALL'  subject=Subject 'ON' tile=[TileDef];
SomeOn: 'SOME' subject=Subject 'ON' tile=[TileDef];
NoEntity: 'NO' entity=[Entity];

Entity: TileDef | ObjectDef;

// =======
// SOUNDS
// =======

Sound:
	event=SoundEvent channel=SoundChannel r0=INT r1=INT r2=INT r3=INT r4=INT;

enum SoundEvent:
	MOVE | BLOCKED | PUSH | ON_GOAL | DESTROY | COMPLETE | RESTART | COLLAPSE | MENU_MOVE | MENU_OK;

enum SoundChannel: NR1 | NR2 | NR3 | NR4;

// =======
// LEVELS
// =======

Level:
	'LEVEL' rows+=STRING+;

// ==========
// TERMINALS
// ==========

terminal SEPARATOR: '=' '='+ (' ' | '\t')* ('\r'? '\n');

terminal HEX: '#' HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT HEX_DIGIT;
terminal fragment HEX_DIGIT: '0'..'9' | 'a'..'f' | 'A'..'F';
